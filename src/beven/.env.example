# LLM Backend: transformers or ollama
LLM_BACKEND=transformers

# LLM Model (for Transformers: a HuggingFace model ID; for Ollama: a local model name)
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Embedding Model
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Backend: chroma or pgvector
VECTOR_BACKEND=chroma

# Chroma directory
CHROMA_DIR=./chroma_data

# Database URL (for pgvector backend)
DATABASE_URL=postgresql://novuspal:novuspal@localhost:5432/novuspal

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# User-Agent for scraping
USER_AGENT=NovusPal/1.0

# Admin API key for ingest endpoints
ADMIN_API_KEY=change_me

# Request delay (seconds between requests to same host)
REQUEST_DELAY_S=2.0

# Max pages per source
MAX_PAGES_PER_SOURCE=50

# Chunk size and overlap
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Sources (comma-separated URLs)
SOURCES=https://news.mtu.edu/,https://events.mtu.edu/